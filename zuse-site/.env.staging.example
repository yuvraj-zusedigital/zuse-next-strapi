# ── Staging environment (staging.zusedigital.com) ───────────────────────────
# Copy to your host's environment (Vercel/again project env, .env.production on
# the staging box, etc.). Do NOT commit real secrets.
#
# SEO safety: because the public origin below is NOT https://zusedigital.com,
# the app automatically (a) serves robots.txt "Disallow: /", (b) emits an empty
# sitemap, (c) marks every page noindex,nofollow, and (d) sends an
# X-Robots-Tag: noindex header. Production (zusedigital.com) is unaffected.

# Public origin of THIS deployment (drives metadataBase, canonicals, OG URLs).
NEXT_PUBLIC_SITE_URL=https://staging.zusedigital.com

# Strapi CMS (same staging CMS)
STRAPI_API_URL=https://stagingadmin.zusedigital.com
STRAPI_TOKEN=__set_in_host_env__
NEXT_PUBLIC_STRAPI_API_URL=https://stagingadmin.zusedigital.com

# ── Recommended: HTTP Basic Auth in front of staging ────────────────────────
# When BOTH are set (and the origin is not production), every request must
# authenticate — crawlers get 401 and can index nothing. This is the strongest
# guarantee of zero SEO impact. Leave unset to rely on robots/noindex only.
SITE_ACCESS_USER=zuse
SITE_ACCESS_PASS=__choose_a_strong_password__

# Shared secret for Strapi's cache refresh (POST /api/revalidate); same value as
# SITE_REVALIDATE_SECRET in Strapi. Without it, changes show within 60 s.
REVALIDATE_SECRET=
