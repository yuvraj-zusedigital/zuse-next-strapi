# Copy to .env.development or .env.local and fill STRAPI_TOKEN
# Mirrors Website/.env.development (GATSBY_* → NEXT_PUBLIC_* for Next.js)

STRAPI_API_URL=https://stagingadmin.zusedigital.com
STRAPI_TOKEN=

# Client-safe only (Gatsby used GATSBY_STRAPI_API_URL)
NEXT_PUBLIC_STRAPI_API_URL=https://stagingadmin.zusedigital.com

# Public site origin — used for metadataBase, canonicals, OG/Twitter URLs, sitemap, robots.
# Localhost is for LOCAL DEV ONLY. In production set the real origin (https://zusedigital.com).
# Safety net: a localhost value is ignored during a production build (see lib/config/site.ts),
# but do not rely on that — set the correct origin in your deploy/CI environment.
NEXT_PUBLIC_SITE_URL=http://localhost:7000

# Shared secret for Strapi's cache refresh (POST /api/revalidate); same value as
# SITE_REVALIDATE_SECRET in Strapi. Without it, changes show within 60 s.
REVALIDATE_SECRET=

# Real-visitor speed (components/WebVitals.tsx): reported in production builds.
# "off" disables it; "on" also reports from `next dev`. SAMPLE = share of visits (0–1).
NEXT_PUBLIC_WEB_VITALS=
NEXT_PUBLIC_WEB_VITALS_SAMPLE=1
