{
  "kind": "collectionType",
  "collectionName": "ezforms_submission",
  "info": {
    "tableName": "submission",
    "singularName": "submission",
    "pluralName": "submissions",
    "displayName": "Form Submissions",
    "description": "A Place for all your form submissions",
    "kind": "collectionType"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "score": {
      "type": "string",
      "min": 1,
      "max": 50,
      "configurable": false
    },
    "formName": {
      "type": "string",
      "min": 1,
      "max": 50,
      "configurable": false
    },
    "data": {
      "type": "json",
      "configurable": false
    },
    "FirstName": {
      "type": "string"
    },
    "LastName": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "phoneNumber": {
      "type": "string"
    },
    "Location": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "device": {
      "type": "string"
    },
    "budget": {
      "type": "string"
    },
    "hearAboutUs": {
      "type": "string"
    },
    "user_trackings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-tracking.user-tracking",
      "mappedBy": "form_submission"
    },
    "Stayupdated": {
      "type": "boolean"
    }
  }
}
