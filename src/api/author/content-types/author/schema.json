{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Author",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "Designation": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "text",
      "maxLength": 255
    },
    "profileUrl": {
      "type": "string",
      "regex": "^https?://.+",
      "private": false
    },
    "sameAs": {
      "type": "text",
      "private": false
    }
  }
}
