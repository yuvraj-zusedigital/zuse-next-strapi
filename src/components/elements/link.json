{
  "collectionName": "components_elements_links",
  "info": {
    "displayName": "Link",
    "icon": "link",
    "description": "A link to a page (preferred: follows the page if its path changes) or to any URL."
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "href": {
      "type": "string"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "primary",
        "secondary"
      ],
      "default": "primary"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "hidden": {
      "type": "boolean",
      "default": false
    }
  }
}
