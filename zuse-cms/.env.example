# Strapi backend (the repo root). No trailing slash.
STRAPI_URL=http://localhost:1338

# 32 random bytes, base64 — encrypts the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Same value as CMS_PROXY_SECRET in the Strapi .env. Without it, login rate
# limits apply to the CMS server as a whole instead of each visitor.
CMS_PROXY_SECRET=

# Public website (zuse-site), for site images in page previews. Optional.
SITE_URL=http://localhost:7100

# Google Search Console in the SEO panel (optional; see docs/cms-deployment.md).
# Service account JSON key (raw JSON or base64), and the property name.
SEARCH_CONSOLE_CREDENTIALS=
SEARCH_CONSOLE_SITE=sc-domain:zusedigital.com
# The live site the property covers (default https://zusedigital.com).
SEARCH_CONSOLE_PAGE_ORIGIN=https://zusedigital.com
# true = sample data, labelled "Demo data" (for trying the panel without access).
SEARCH_CONSOLE_DEMO=
