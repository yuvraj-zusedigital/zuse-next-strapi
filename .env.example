HOST=
PORT=

# ── Strapi core ──────────────────────────────────────────────
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
NODE_ENV=

# ── Database (Postgres - staging) ────────────────────────────
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=

# ── AWS S3 / CDN ─────────────────────────────────────────────
accessKeyId=
secretAccessKey=
AWS_REGION=
AWS_BUCKET=
AWS_BUCKET_NAME=
CDN_URL=

# ── Email (SendGrid) ──────────────────────────────────
DEFAULT_FROM=
DEFAULT_ReplyTo=
SENDGRID_API_KEY=

# ── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=

# ── HubSpot ──────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_TTS_VOICE=
OPENAI_TTS_VOICES=
# Zuse CMS "Draft with AI" (pages). Uses OPENAI_API_KEY; model defaults to gpt-4o-mini.
OPENAI_PAGE_DRAFT_MODEL=
# true = a fixed sample draft without calling OpenAI (local testing only)
CMS_AI_DEMO=

# ── ElevenLabs ───────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_TTS_VOICES=

# ── Public URL ───────────────────────────────────────────────
PUBLIC_URL=
BLOG_BASE_PATH=

# ── GitHub ───────────────────────────────────────────────────
GITHUB_TOKEN=
# ── Zuse CMS ─────────────────────────────────────────────────
# Shared secret with zuse-cms (openssl rand -hex 32); lets the CMS forward visitor IPs.
CMS_PROXY_SECRET=

# Next.js site cache refresh (zuse-site app/api/revalidate). Comma-separate several sites.
# SITE_REVALIDATE_SECRET must equal REVALIDATE_SECRET in the site's environment.
SITE_REVALIDATE_URL=
SITE_REVALIDATE_SECRET=
